  "cards": [
    {
      "dot": "cyan",
      "title": "One service",
      "items": [
        "Express serves the built React app and /api from one Railway service",
        "Locally, Vite serves the app on :5174 and proxies /api to :3001"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data",
      "items": [
        "Uploaded images and payment-proof files are stored as bytes in PostgreSQL, never on disk",
        "Production runs Railway PostgreSQL 18; local Docker runs 16"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "HTTPS redirect, HSTS and a Helmet CSP in production",
        "Per-route rate limits on login, sign-up, codes, uploads and check-in",
        "Short-lived Bearer token plus an httpOnly refresh cookie"
      ]
    }
  ]
