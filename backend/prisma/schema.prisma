// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  role                  Role      @default(USER)
  tokenVersion          Int       @default(0)
  isVerified            Boolean   @default(false)
  lastCodeSentAt        DateTime  @default(now())
  verificationExpiresAt DateTime
  createdAt             DateTime  @default(now())
  info                  UserInfo?
  sessions              AuthSession[]
  invitationsSent       AdminInvitation[] @relation("InvitationSender")
  invitationsAccepted   AdminInvitation[] @relation("InvitationAccepter")
  roleChangesMade       RoleChangeAudit[] @relation("RoleChangeActor")
  roleChangesReceived   RoleChangeAudit[] @relation("RoleChangeTarget")
}

model UserInfo {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  studentId String
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id              String   @id @default(uuid())
  userId          String
  refreshTokenHash String  @unique
  expiresAt       DateTime
  lastUsedAt      DateTime @default(now())
  revokedAt       DateTime?
  revokedReason   String?  @db.VarChar(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AdminInvitation {
  id               String   @id @default(uuid())
  tokenHash        String   @unique
  invitedEmail     String
  invitedRole      Role     @default(ADMIN)
  invitedByUserId  String
  acceptedByUserId String?
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  invitedBy        User     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?    @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([invitedEmail, expiresAt])
  @@index([invitedByUserId])
}

model RoleChangeAudit {
  id          Int      @id @default(autoincrement())
  actorUserId String
  targetUserId String
  fromRole    Role
  toRole      Role
  reason      String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  actor       User     @relation("RoleChangeActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target      User     @relation("RoleChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// --- COMMUNICATION LINKS ---
// Stores social media, discord, membership, and email links
model CommunicationLink {
  id          Int      @id @default(autoincrement())
  platform    String   @unique // e.g., 'instagram', 'email', 'discord_invite', 'membership_signup'
  url         String
  imgUrl      String
  description String?  @db.VarChar(150) // Short description shown on the social card
  isActive    Boolean  @default(true) // Allows admins to temporarily hide a link
  updatedAt   DateTime @updatedAt
}

// --- MEDIA CONFIG ---
// Stores global media settings
model MediaConfig {
  id            Int      @id @default(autoincrement())
  mediaDriveUrl String
  updatedAt     DateTime @updatedAt
}

// --- SPONSORSHIP CONFIG ---
// Stores the general text/content for the sponsorship page
model SponsorshipPage {
  id          Int       @id @default(autoincrement())
  pageContent String    @db.Text // Use Text for longer descriptions
  sponsors    Sponsor[] // Relation to the Sponsor table
  updatedAt   DateTime  @updatedAt
}

// Stores individual sponsors (The "Sponsor List")
model Sponsor {
  id                Int             @id @default(autoincrement())
  name              String
  logoUrl           String?
  heroImageUrl      String? // Homepage screenshot used as card background
  websiteUrl        String?
  displayOrder      Int             @default(0)
  sponsorshipPageId Int
  sponsorshipPage   SponsorshipPage @relation(fields: [sponsorshipPageId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// --- ACTIVITIES ---
// Stores upcoming/past club events and activities
model Activity {
  id           Int          @id @default(autoincrement())
  title        String
  description  String       @db.Text
  startTime    DateTime
  endTime      DateTime
  imageUrl     String?
  externalLink String?
  isPublished  Boolean      @default(true)
  capacity     Int? // null = unlimited capacity
  mediaEntries MediaEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  rsvps        Rsvp[]
}

// --- RSVPS ---
// Stores RSVP submissions for activities/events
model Rsvp {
  id         Int      @id @default(autoincrement())
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  email      String
  studentId  String
  createdAt  DateTime @default(now())

  @@unique([activityId, email])
  @@index([activityId])
}

// --- EXEC COMMITTEE ---
model ExecRole {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  displayOrder Int         @default(0)
  executives   Executive[]
  createdAt    DateTime    @default(now())
}

model ExecTeam {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  displayOrder Int         @default(0)
  executives   Executive[]
  createdAt    DateTime    @default(now())
}

model Executive {
  id           Int       @id @default(autoincrement())
  name         String
  imageUrl     String?
  bio          String?   @db.VarChar(300)
  instagramUrl String?
  email        String?
  isActive     Boolean   @default(true)
  roleId       Int?
  role         ExecRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  teamId       Int?
  team         ExecTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- FAQ ---
model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.VarChar(300)
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MEDIA ENTRIES ---
// Each entry maps one activity to a specific drive folder.
model MediaEntry {
  id            Int      @id @default(autoincrement())
  activityId    Int
  mediaDriveUrl String
  overrideName  String?
  overrideCover String?
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activityId])
}
