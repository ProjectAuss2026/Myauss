// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

// Membership account status — distinct from `User.isVerified` (email OTP).
// INACTIVE  = registered but membership not yet paid/confirmed
// IN_REVIEW = cash/bank-transfer proof submitted, awaiting admin verification
// VERIFIED  = active member (payment confirmed); unlocks gated content
enum MembershipStatus {
  INACTIVE
  IN_REVIEW
  VERIFIED
}

enum PaymentProofUploadStatus {
  PENDING
  LINKED
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  passwordHash          String
  role                      Role                    @default(USER)
  tokenVersion              Int                     @default(0)
  isVerified                Boolean                 @default(false)
  membershipStatus          MembershipStatus        @default(INACTIVE)
  membershipStatusUpdatedAt DateTime                @default(now())
  inactiveWarnedAt          DateTime?
  lastCodeSentAt            DateTime                @default(now())
  verificationExpiresAt     DateTime
  createdAt                 DateTime                @default(now())
  info                      UserInfo?
  sessions                  AuthSession[]
  otpCode                   OtpCode?
  invitationsSent           AdminInvitation[]       @relation("InvitationSender")
  invitationsAccepted       AdminInvitation[]       @relation("InvitationAccepter")
  roleChangesMade           RoleChangeAudit[]       @relation("RoleChangeActor")
  roleChangesReceived       RoleChangeAudit[]       @relation("RoleChangeTarget")
  membershipChangesMade     MembershipStatusAudit[] @relation("MembershipChangeActor")
  membershipChangesReceived MembershipStatusAudit[] @relation("MembershipChangeTarget")
  passwordResets            PasswordReset[]
  paymentProofUploads       PaymentProofUpload[]
  uploadedImages            UploadedImage[]
  payments                  Payment[]
  rsvps                     Rsvp[]

  @@index([membershipStatus, membershipStatusUpdatedAt])
}

// --- PAYMENT LEDGER (KAN-138 AC7) ---
// Auditable record of every confirmed card/wallet payment, written idempotently
// from both the /payments/confirm re-verification and the Stripe webhook
// (upserted on stripePaymentIntentId). Unlike the audit tables this is a
// financial ledger: userId is nullable with SetNull so transactions survive
// account deletion, and payerEmail snapshots the payer for later reference.
// No raw card data is stored — only Stripe's tokenized brand/last4 metadata.
model Payment {
  id                    String   @id @default(uuid())
  userId                String?
  payerEmail            String
  stripePaymentIntentId String   @unique
  amountCents           Int
  currency              String   @db.VarChar(3) // ISO 4217 lowercase, e.g. "nzd"
  method                String   @db.VarChar(40) // Stripe payment_method_details.type, e.g. "card"
  cardBrand             String?  @db.VarChar(20) // e.g. "visa", "mastercard"
  cardLast4             String?  @db.VarChar(4)
  paidAt                DateTime
  createdAt             DateTime @default(now())
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, paidAt])
  @@index([paidAt])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Payment proof files are sensitive PII. The uploaded bytes are stored in the
// database, are only retrievable by authorised admins, and unlinked staged
// uploads expire for cleanup under the retention policy in the cleanup job.
model PaymentProofUpload {
  id               String                   @id @default(uuid())
  userId           String?
  originalFilename String
  fileBytes        Bytes
  mimeType         String
  sizeBytes        Int
  status           PaymentProofUploadStatus @default(PENDING)
  linkedAt         DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  expiresAt        DateTime
  user             User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// Uploaded image files are stored in the database (like PaymentProofUpload)
// so they survive ephemeral-filesystem redeploys on Railway. The uploaded bytes
// are publicly retrievable by URL (no auth required for display in <img> tags)
// and unlinked uploads may be cleaned up by a future retention job.
model UploadedImage {
  id               String   @id @default(uuid())
  userId           String?
  originalFilename String?
  fileBytes        Bytes
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())
  expiresAt        DateTime?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model UserInfo {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  studentId String? // Stores SHA-256 hash of normalized student ID + STUDENT_ID_PEPPER when provided; field name retained to avoid a risky data migration.
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(120)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model OtpCode {
  id                String    @id @default(uuid())
  userId            String    @unique
  codeHash          String
  expiresAt         DateTime
  attemptsRemaining Int       @default(5)
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, consumedAt])
}

model AdminInvitation {
  id               String    @id @default(uuid())
  tokenHash        String    @unique
  invitedEmail     String
  invitedRole      Role      @default(ADMIN)
  invitedByUserId  String
  acceptedByUserId String?
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  invitedBy        User      @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?     @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([invitedEmail, expiresAt])
  @@index([invitedByUserId])
}

model RoleChangeAudit {
  id           Int      @id @default(autoincrement())
  actorUserId  String
  targetUserId String
  fromRole     Role
  toRole       Role
  reason       String?  @db.VarChar(200)
  createdAt    DateTime @default(now())
  actor        User     @relation("RoleChangeActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target       User     @relation("RoleChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// Timestamped, auditable record of every membership status transition.
// actorUserId is null for system-driven changes (e.g. automated jobs).
model MembershipStatusAudit {
  id           Int              @id @default(autoincrement())
  actorUserId  String?
  targetUserId String
  fromStatus   MembershipStatus
  toStatus     MembershipStatus
  reason       String?          @db.VarChar(200)
  createdAt    DateTime         @default(now())
  actor        User?            @relation("MembershipChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User             @relation("MembershipChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// --- COMMUNICATION LINKS ---
// Stores social media, discord, membership, and email links
model CommunicationLink {
  id          Int      @id @default(autoincrement())
  platform    String   @unique // e.g., 'instagram', 'email', 'discord_invite', 'membership_signup'
  url         String
  imgUrl      String
  description String?  @db.VarChar(150) // Short description shown on the social card
  isActive    Boolean  @default(true) // Allows admins to temporarily hide a link
  updatedAt   DateTime @updatedAt
}

// --- MEDIA CONFIG ---
// Stores global media settings
model MediaConfig {
  id            Int      @id @default(autoincrement())
  mediaDriveUrl String
  updatedAt     DateTime @updatedAt
}

// --- SPONSORSHIP CONFIG ---
// Stores the general text/content for the sponsorship page
model SponsorshipPage {
  id          Int       @id @default(autoincrement())
  pageContent String    @db.Text // Use Text for longer descriptions
  sponsors    Sponsor[] // Relation to the Sponsor table
  updatedAt   DateTime  @updatedAt
}

// Stores individual sponsors (The "Sponsor List")
model Sponsor {
  id                Int             @id @default(autoincrement())
  name              String
  logoUrl           String?
  heroImageUrl      String? // Homepage screenshot used as card background
  websiteUrl        String?
  displayOrder      Int             @default(0)
  sponsorshipPageId Int
  sponsorshipPage   SponsorshipPage @relation(fields: [sponsorshipPageId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// --- ACTIVITIES ---
// Stores upcoming/past club events and activities
model Activity {
  id           Int          @id @default(autoincrement())
  title        String
  description  String       @db.Text
  startTime    DateTime
  endTime      DateTime
  imageUrl     String?
  externalLink String?
  isPublished  Boolean      @default(true)
  capacity     Int? // null = unlimited capacity
  mediaEntries MediaEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  rsvps        Rsvp[]
}

// --- RSVPS ---
// Stores RSVP submissions for activities/events
model Rsvp {
  id         Int      @id @default(autoincrement())
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // Best-effort link to the member account behind this RSVP (KAN-171). Nullable
  // because legacy rows predate the members-only gate (KAN-178) and were created
  // through the old public, unauthenticated RSVP route with no account behind
  // them. SetNull — NOT Cascade — so deleting a user (including via the KAN-134
  // inactive-account retention job) clears the link but preserves the RSVP row;
  // cascading would silently erase historical attendance and event headcounts.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String
  studentId  String? // Plaintext is currently used for admin attendee display/export when provided; confirm privacy policy or encryption-at-rest requirements.
  createdAt  DateTime @default(now())

  @@unique([activityId, email])
  @@index([activityId])
  @@index([userId, createdAt])
}

// --- EXEC COMMITTEE ---
model ExecRole {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  displayOrder Int         @default(0)
  executives   Executive[]
  createdAt    DateTime    @default(now())
}

model ExecTeam {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  displayOrder Int         @default(0)
  executives   Executive[]
  createdAt    DateTime    @default(now())
}

model Executive {
  id           Int       @id @default(autoincrement())
  name         String
  imageUrl     String?
  bio          String?   @db.VarChar(300)
  instagramUrl String?
  email        String?
  isActive     Boolean   @default(true)
  roleId       Int?
  role         ExecRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  teamId       Int?
  team         ExecTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- FAQ ---
model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.VarChar(300)
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MEDIA ENTRIES ---
// Each entry maps one activity to a specific drive folder.
model MediaEntry {
  id            Int      @id @default(autoincrement())
  activityId    Int
  mediaDriveUrl String
  overrideName  String?
  overrideCover String?
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activityId])
}
