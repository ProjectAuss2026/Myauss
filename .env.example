# Database Configuration
DATABASE_URL=postgresql://auss_user:auss_password@localhost:5433/auss_db

# Backend Configuration
NODE_ENV=development
PORT=
CORS_ORIGINS=http://localhost:5174
HSTS_PRELOAD=false
UPLOADS_PUBLIC_ORIGIN=
CSP_IMAGE_SRC_ORIGINS=
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Frontend Configuration
VITE_BACKEND_PORT=
VITE_SENTRY_DSN=
VITE_ENABLE_SENTRY_TEST_BUTTON=
APP_URL=http://localhost:5174

# Stripe (membership payments). Use TEST keys while developing.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret — Dashboard → Developers → Webhooks (or `stripe listen`
# for local dev). Required for POST /api/payments/webhook to activate members.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Membership amount in the smallest currency unit (cents). Defaults: 2000 / nzd
MEMBERSHIP_PRICE_CENTS=2000
MEMBERSHIP_CURRENCY=nzd

# JWT Configuration
JWT_SECRET=auss-dev-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=auss-api
JWT_AUDIENCE=auss-web

# Optional owner bootstrap via seed (recommended for first secure owner account)
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=

# Student ID hashing pepper. Use a long random secret in each environment.
STUDENT_ID_PEPPER=change-this-student-id-pepper

# Membership lifecycle windows (all in days; jobs run daily).
# INACTIVE accounts are warned by email, then hard-deleted after the retention
# window (committee-confirmed, applies to all inactive accounts — see KAN-104).
MEMBERSHIP_INACTIVE_RETENTION_DAYS=21
# How many days before deletion the warning email is sent (also the min grace
# between warning and deletion). Clamped below the retention window.
MEMBERSHIP_INACTIVE_WARNING_DAYS=7
# A VERIFIED membership lasts one semester; after this it lapses to INACTIVE and
# the member is emailed to renew.
MEMBERSHIP_VERIFIED_DURATION_DAYS=91

# SMTP Configuration (Gmail — use an App Password, not your real password)
# 1. Enable 2-Step Verification: Google Account → Security → 2-Step Verification
# 2. Generate App Password: Google Account → Security → App Passwords → Create one for "Mail"
# 3. Paste the 16-character app password below (spaces are fine)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=AUSS <your-gmail@gmail.com>

# Email deliverability — comma-separated domain allowlist that skips MX record checks.
# Register with domains in this list will skip DNS MX verification.
# Example: uoa.auckland.ac.nz,auckland.ac.nz,aucklanduni.ac.nz
EMAIL_MX_ALLOWLIST=
